# Backend origin only: localhost or the HTTPS origin from `ngrok http 8000`.
# Change this when the backend host changes; restart `next dev` (rebuild production).
API_URL=http://localhost:8000
# Optional public origin embedded in admit-card QR codes. Use a phone-accessible LAN IP or domain for scanning.
NEXT_PUBLIC_APP_URL=
# Show the maintenance page on frontend routes (API and support reporting stay available).
MAINTENANCE_MODE=false
# Contact Us page par dikhne wali details (khali chhodne par woh card nahi dikhega)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=Monday - Saturday, 9:00 AM - 5:00 PM
