DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-50-characters-xxxxxxxx
# Generate a dedicated encryption key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AADHAAR_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
ALLOWED_HOSTS=app.yourdomain.com
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
DATABASE_URL=postgres://erp:replace-with-a-long-random-alphanumeric-password@db:5432/erp
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com
# Cookie domain: agar frontend app.x.com aur API api.x.com hai to ".x.com"
AUTH_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=
USE_X_FORWARDED_FOR=True
# Public edge proxy + internal Nginx: match the trusted X-Forwarded-For hop count.
DRF_NUM_PROXIES=1
# Admin panel ka URL secret rakhein; load balancer isi path ko Django par bhejta hai.
ADMIN_URL=secure-admin-change-me/

# ---------- STRE (talent exam) portal ----------
# Email links (status page / admit card) isi address par khulenge
SITE_URL=https://your-domain.com
DEFAULT_FROM_EMAIL=Oshitech <admin@oshitech.in>
# GoDaddy Professional Email powered by Titan SMTP (password ko hosting secret mein rakhein)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=admin@oshitech.in
EMAIL_HOST_PASSWORD=anoopgaurav@420
# Online payment (Razorpay). Khali chhodne par candidate UPI se pay karke transaction ID daalta hai.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRE_UPI_ID=
STRE_PAYEE_NAME=STRE Exam Cell
# Cashfree (asli keys Cashfree dashboard -> Developers -> API Keys se; yahan kabhi mat likho)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox (test) ya production
CASHFREE_ENV=sandbox
# Payment hote hi Cashfree yahan khabar bhejta hai (HTTPS zaroori)
CASHFREE_NOTIFY_URL=https://your-domain.com/api/v1/stre/pay/cashfree-webhook/
# online = site par checkout (sab automatic) | link = sirf payment link | both
STRE_PAYMENT_MODE=online
STRE_PAYMENT_FORM_URL=

# Backup (scripts/backup.ps1). Khali = %USERPROFILE%\OshitechBackups. Google Drive / OneDrive folder do to copy cloud par bhi.
# BACKUP_DIR=D:\OshitechBackups
# BACKUP_KEEP_DAYS=14
STRE_PAYMENT_MODE=online